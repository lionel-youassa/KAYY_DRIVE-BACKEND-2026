# --- Firebase Admin SDK ---
# JSON complet du Service Account, téléchargé depuis Firebase Console >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée.
# Copiez-collez le JSON TEL QUEL (il contient déjà les \n correctement échappés).
FIREBASE_ADMIN_CONFIG={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}

# --- JWT et authentification moderne ---
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_2FA_REQUIRED=true
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_SECONDS=60
# Secret HMAC dédié aux codes OTP. À défaut, JWT_SECRET est utilisé.
AUTH_OTP_PEPPER=

# --- Brevo (e-mails transactionnels) ---
# Sans clé en développement, les codes sont écrits dans les logs.
# En production, l’envoi échoue avec une erreur 503 si Brevo n’est pas configuré.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=KAYY Drive

# --- Google Sign-In (OAuth Client ID de type Web) ---
# Plusieurs audiences possibles, séparées par des virgules.
GOOGLE_CLIENT_IDS=

# --- Redis (utilisé par BullMQ pour la queue Safe-Drive) ---
# En local avec docker-compose, le service Redis s'appelle généralement "redis" :
REDIS_URL=redis://redis:6379
# En développement sans Docker : REDIS_URL=redis://localhost:6379
# Avec Upstash (production) : REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# --- Stockage S3 (Cloudflare R2, AWS S3, MinIO...) ---
# Local (docker-compose) :
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=kayydrive
S3_PUBLIC_BASE_URL=http://localhost:9000/kayydrive
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_SET_PUBLIC_POLICY=true
# Production R2 : S3_ENDPOINT=<account>.r2.cloudflarestorage.com, S3_PORT=443,
# S3_USE_SSL=true, S3_REGION=auto, S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev,
# S3_AUTO_CREATE_BUCKET=false, S3_SET_PUBLIC_POLICY=false.
# Legacy : les variables MINIO_* restent supportées.

PORT=3000
