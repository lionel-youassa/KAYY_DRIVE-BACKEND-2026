# --- Firebase Admin SDK ---
# JSON complet du Service Account, téléchargé depuis Firebase Console >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée.
# Copiez-collez le JSON TEL QUEL (il contient déjà les \n correctement échappés).
FIREBASE_ADMIN_CONFIG={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}

# --- Redis (utilisé par BullMQ pour la queue Safe-Drive) ---
# En local avec docker-compose, le service Redis s'appelle généralement "redis" :
REDIS_URL=redis://redis:6379
# En développement sans Docker : REDIS_URL=redis://localhost:6379
# Avec Upstash (production) : REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

PORT=3000
