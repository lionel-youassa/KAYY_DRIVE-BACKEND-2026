rules_version = '2';

// ---------------------------------------------------------------------------
// Règles de sécurité Firestore pour Kayy
// ---------------------------------------------------------------------------
// Principe : TOUTES les écritures et la plupart des lectures sensibles
// passent par votre backend Next.js (qui utilise le Admin SDK et donc
// CONTOURNE ces règles). Ces règles ne servent qu'à bloquer les accès
// directs depuis l'app mobile/web via le SDK client Firebase.
//
// Déploiement : firebase deploy --only firestore:rules
// (nécessite le fichier firebase.json + firebase-tools installé)

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }

    function estProprietaire(uid) {
      return estConnecte() && request.auth.uid == uid;
    }

    function estAdmin() {
      return estConnecte() && request.auth.token.role == 'admin';
    }

    // -----------------------------------------------------------------------
    // users : chaque utilisateur peut lire son propre profil.
    // Aucune écriture directe (tout passe par /api/auth/* côté serveur).
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if estProprietaire(userId) || estAdmin();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // incidents : lecture publique aux connectés (utile pour affichage carte),
    // écriture interdite en direct (passe par /api/incidents).
    // -----------------------------------------------------------------------
    match /incidents/{incidentId} {
      allow read: if estConnecte();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // routes (raccourcis communautaires) : lecture publique aux connectés,
    // écriture interdite en direct (passe par /api/routes).
    // -----------------------------------------------------------------------
    match /routes/{routeId} {
      allow read: if estConnecte();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // adresses_favorites : strictement privé au propriétaire.
    // -----------------------------------------------------------------------
    match /adresses_favorites/{docId} {
      allow read: if estConnecte() && resource.data.id_utilisateur == request.auth.uid;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // trafic, predictions : lecture connectée, écriture jamais directe
    // (alimenté uniquement par le Worker backend).
    // -----------------------------------------------------------------------
    match /trafic/{docId} {
      allow read: if estConnecte();
      allow write: if false;
    }

    match /predictions/{docId} {
      allow read: if estConnecte();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // notifications : un utilisateur ne lit que les siennes.
    // -----------------------------------------------------------------------
    match /notifications/{docId} {
      allow read: if estConnecte() && resource.data.id_utilisateur == request.auth.uid;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // categories, preferences : lecture connectée (référentiel), écriture admin
    // pour categories, propriétaire pour ses propres préférences (lecture seule
    // ici aussi, l'écriture passe par l'API pour valider les données).
    // -----------------------------------------------------------------------
    match /categories/{docId} {
      allow read: if estConnecte();
      allow write: if false;
    }

    match /preferences/{docId} {
      allow read: if estConnecte() && resource.data.id_utilisateur == request.auth.uid;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Par défaut : tout le reste est bloqué.
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
