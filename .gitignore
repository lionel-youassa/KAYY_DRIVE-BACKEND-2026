# Global ignore rules
.DS_Store
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files (secrets)
.env
.env.local
.env.*.local

# Core-api (NestJS) specific ignores
/core-api/node_modules
/core-api/dist
/core-api/coverage
/core-api/.env

# IA-service (FastAPI) specific ignores
/ia-service/venv
/ia-service/__pycache__
/ia-service/.env
/ia-service/.env.local
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Docker files
.docker
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OSRM data files (gros fichiers binaires générés)
osrm-data/*.osrm*
osrm-data/*.osm.pbf
