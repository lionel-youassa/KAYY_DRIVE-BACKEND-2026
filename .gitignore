# Global ignore rules
.DS_Store
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
venv/
**/__pycache__/
**/*.pyc

# Core-api (NestJS) specific ignores
/core-api/node_modules
/core-api/dist
/core-api/coverage
/core-api/.env

# IA-service (FastAPI) specific ignores
/ia-service/venv
/ia-service/__pycache__
/ia-service/.env

# Docker files
.docker
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*