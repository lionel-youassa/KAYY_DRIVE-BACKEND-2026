# KayyDrive Docker Environment Configuration
# This file is a template. Copy it to .env and fill in the actual values.

# PostgreSQL Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=kayydrive_db
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@postgres:5432/kayydrive_db

# Redis Configuration
REDIS_URL=redis://redis:6379

# Core API Configuration
PORT=3000
NODE_ENV=development
OSRM_URL=http://osrm-backend:5000
IA_SERVICE_URL=http://ia-service:8000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production

# Firebase Configuration (Optional - for production)
FIREBASE_ADMIN_CONFIG=

# IA Service Configuration
PYTHON_ENV=development
GEMINI_API_KEY=your_gemini_api_key

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=your_pgadmin_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
