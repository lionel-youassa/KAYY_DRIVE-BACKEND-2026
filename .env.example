# KayyDrive Docker Environment Configuration
# This file is a template. Copy it to .env and fill in the actual values.

# PostgreSQL Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=kayydrive_db
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@postgres:5432/kayydrive_db

# Redis Configuration
REDIS_URL=redis://redis:6379

# Core API Configuration
PORT=3000
NODE_ENV=development
# En local (Docker) :
OSRM_URL=http://osrm-backend:5000
IA_SERVICE_URL=http://ia-service:8000
# En production (Render), remplacer par les services publics :
# OSRM_URL=https://kayy-osrm.onrender.com
# IA_SERVICE_URL=https://kayy-ia.onrender.com
# Origines autorisées pour le frontend Web (séparées par des virgules, ou *).
CORS_ORIGINS=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production

# Stockage S3 (Cloudflare R2, AWS S3, MinIO, Backblaze B2...)
# Local (docker-compose) : MinIO
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=kayydrive
# URL publique de base utilisee dans les fichiers renvoyes.
# Inclure le bucket si le fournisseur l'exige (MinIO path-style, AWS virtual-host).
S3_PUBLIC_BASE_URL=http://localhost:9000/kayydrive
S3_FORCE_PATH_STYLE=true
# Creation automatique du bucket et politique publique : local uniquement.
S3_AUTO_CREATE_BUCKET=true
S3_SET_PUBLIC_POLICY=true
#
# Production - Cloudflare R2 (recommande) :
# S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# S3_PORT=443
# S3_USE_SSL=true
# S3_REGION=auto
# S3_ACCESS_KEY=<r2-access-key-id>
# S3_SECRET_KEY=<r2-secret-access-key>
# S3_BUCKET=kayydrive
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev   (ou domaine personnalise)
# S3_FORCE_PATH_STYLE=true
# S3_AUTO_CREATE_BUCKET=false
# S3_SET_PUBLIC_POLICY=false
#
# Legacy toujours supporte : MINIO_ENDPOINT, MINIO_PORT, MINIO_USE_SSL,
# MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET, MINIO_PUBLIC_URL

# Firebase Configuration (Optional - for production)
FIREBASE_ADMIN_CONFIG=

# IA Service Configuration
PYTHON_ENV=development
GEMINI_API_KEY=your_gemini_api_key

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=your_pgadmin_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
